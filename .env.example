# Copy to .env and fill in. NEVER commit .env.
# Use a FRESH test wallet only. Testnet funds only.

# Deployer wallet private key (test wallet only)
DEPLOYER_PRIVATE_KEY=

# RPC provider (https://dashboard.alchemy.com)
ALCHEMY_API_KEY=

# Contract verification (https://etherscan.io/myapikey — one key works for Sepolia & Base Sepolia via Etherscan V2)
ETHERSCAN_API_KEY=

# Wallet connection (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# LLM API (only if the project uses AI)
OPENAI_API_KEY=
